{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Web index (record/views/index/web.json)",
  "description": "The story web in the web_index action's shape, built from the link and web notes on the rules of the links views (newest web per country, at most 30 days old). Not in it: the run's `targets`, `coverage` totals and `runId` (no note carries them). `generatedAt` = the newest web's time (null with no web).",
  "type": "object",
  "required": ["schemaVersion", "builtFrom", "generatedAt", "maxAgeDays", "websUsed", "links", "shared", "threads"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "builtFrom": {"type": "object"},
    "generatedAt": {"type": ["string", "null"]},
    "maxAgeDays": {"const": 30},
    "websUsed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["country", "generatedAt", "nodes"],
        "additionalProperties": false,
        "properties": {"country": {"type": "string"}, "generatedAt": {"type": "string"}, "nodes": {"type": "integer", "minimum": 0}}
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "confidence", "lagDays", "mechanism", "cited", "country", "generatedAt", "iso3"],
        "additionalProperties": false,
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "confidence": {"type": ["string", "null"]},
          "lagDays": {"type": ["number", "null"]},
          "mechanism": {"type": ["string", "null"]},
          "cited": {"type": "array", "items": {"type": "object"}},
          "country": {"type": "string"},
          "generatedAt": {"type": "string"},
          "iso3": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "shared": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["a", "b", "actors", "weight", "country", "generatedAt", "iso3"],
        "additionalProperties": false,
        "properties": {
          "a": {"type": "string"},
          "b": {"type": "string"},
          "actors": {"type": "array", "items": {"type": "string"}},
          "weight": {"type": "number"},
          "country": {"type": "string"},
          "generatedAt": {"type": "string"},
          "iso3": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "threads": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "description": "the shared story fields of story-stamp.schema.json except iso3 (here `iso3` stays the thread's top places in the web window); `title` is the story's one title, the web node summary only for a thread the record holds no row for (its other stamp fields are then null or empty with their reasons)",
        "required": ["state", "threadId", "title", "line", "lineWeek", "lineReason", "name", "regions", "tier", "riskScore", "riskAt", "tierReason", "lastFactAt", "lastEntryAt", "category", "born", "themeId", "entries", "places", "analysedIn", "iso3"],
        "additionalProperties": false,
        "properties": {
          "state": {"enum": ["linked", "analysed_no_links", "single_update", "country_not_analysed"]},
          "threadId": {"$ref": "story-stamp.schema.json#/properties/threadId"},
          "title": {"$ref": "story-stamp.schema.json#/properties/title"},
          "line": {"$ref": "story-stamp.schema.json#/properties/line"},
          "lineWeek": {"$ref": "story-stamp.schema.json#/properties/lineWeek"},
          "lineReason": {"$ref": "story-stamp.schema.json#/properties/lineReason"},
          "name": {"$ref": "story-stamp.schema.json#/properties/name"},
          "regions": {"$ref": "story-stamp.schema.json#/properties/regions"},
          "tier": {"$ref": "story-stamp.schema.json#/properties/tier"},
          "riskScore": {"$ref": "story-stamp.schema.json#/properties/riskScore"},
          "riskAt": {"$ref": "story-stamp.schema.json#/properties/riskAt"},
          "tierReason": {"$ref": "story-stamp.schema.json#/properties/tierReason"},
          "lastFactAt": {"$ref": "story-stamp.schema.json#/properties/lastFactAt"},
          "lastEntryAt": {"$ref": "story-stamp.schema.json#/properties/lastEntryAt"},
          "category": {"$ref": "story-stamp.schema.json#/properties/category"},
          "born": {"$ref": "story-stamp.schema.json#/properties/born"},
          "themeId": {"$ref": "story-stamp.schema.json#/properties/themeId"},
          "entries": {"type": "integer", "minimum": 0},
          "places": {"type": "array", "items": {"type": "object", "required": ["name", "n"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "n": {"type": "integer"}}}},
          "analysedIn": {"type": "array", "items": {"type": "object", "required": ["country", "generatedAt"], "additionalProperties": false, "properties": {"country": {"type": "string"}, "generatedAt": {"type": "string"}}}},
          "iso3": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
