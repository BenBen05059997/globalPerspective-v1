{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Views manifest",
  "description": "record/views/manifest.json, written last (0037 section 2)",
  "type": "object",
  "required": [
    "schemaVersion",
    "builtAt",
    "runId",
    "factsManifestDays",
    "factsThrough",
    "readingsThrough"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "builtAt": {
      "$ref": "#/definitions/iso"
    },
    "runId": {
      "type": "string"
    },
    "factsManifestDays": {
      "type": "integer",
      "minimum": 0
    },
    "factsThrough": {
      "anyOf": [
        {
          "$ref": "#/definitions/day"
        },
        {
          "type": "null"
        }
      ]
    },
    "readingsThrough": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-W\\d{2}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "newest ISO week among the readings the build used; null when there are none"
    },
    "provisionalThrough": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "the newest day of the provisional entries (today's archive before the nightly run has frozen it, 0050); absent when the build had none"
    },
    "provisionalEntries": {
      "type": "integer",
      "minimum": 1,
      "description": "how many provisional entries the build used; present with provisionalThrough"
    }
  },
  "definitions": {
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "iso": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:.]+Z$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "builtFrom": {
      "type": "object",
      "required": [
        "factsThrough",
        "readingsThrough"
      ],
      "additionalProperties": false,
      "properties": {
        "factsThrough": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "readingsThrough": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-W\\d{2}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "newest ISO week among the readings the build used; null when there are none"
        },
        "provisionalThrough": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "the newest day of the provisional entries (today's archive before the nightly run has frozen it, 0050); absent when the build had none"
        }
      }
    }
  }
}
