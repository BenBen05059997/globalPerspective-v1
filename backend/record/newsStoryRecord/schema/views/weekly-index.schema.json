{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Weekly index (record/views/index/weekly.json)",
  "description": "The last 30 archive days (the archive_range action's days) for the Stories page, the Stories map, the countries list and the map's risk layer. A day is the archive day the entry was listed under; an article listed again on a later day is not a second entry. Per entry only what the readers show: topic, story (as placed now, merges applied), title, category, the entry's ISO3 countries and its sources as outlet and url. `updatedAt` is the newest entry time of the day. Built by indexViews.js from the story views' entries.",
  "type": "object",
  "required": ["schemaVersion", "builtFrom", "from", "to", "days"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "builtFrom": {"type": "object"},
    "from": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "to": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "days": {
      "type": "object",
      "propertyNames": {"pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
      "additionalProperties": {
        "type": "object",
        "required": ["updatedAt", "entries"],
        "additionalProperties": false,
        "properties": {
          "updatedAt": {"type": ["string", "null"]},
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["topicId", "threadId", "title", "category", "iso3", "sources"],
              "additionalProperties": false,
              "properties": {
                "topicId": {"type": ["string", "null"]},
                "threadId": {"type": "string"},
                "title": {"type": "string"},
                "category": {"type": ["string", "null"]},
                "iso3": {"type": "array", "items": {"type": "string"}},
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["outlet", "url"],
                    "additionalProperties": false,
                    "properties": {"outlet": {"type": ["string", "null"]}, "url": {"type": ["string", "null"]}}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
