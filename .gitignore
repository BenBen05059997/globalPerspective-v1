# Global ignores
.DS_Store
node_modules/
dist/
coverage/
__pycache__/
*.pyc

# Env files (keep examples)
.env*
!.env.example

# Vite/React build artifacts
global-perspectives-starter/frontend/site-dist/
global-perspectives-starter/frontend/.wrangler/
.site-releases/

# Lambda deploy artifacts (scripts/lambda.sh writes builds + pre-deploy backups to .deploy-backups/)
backend/**/*.zip
backend/**/*.zip.bak
.deploy-backups/

# IDE/editor
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?
# Firebase Admin SDK service account (sensitive credentials)
*-firebase-adminsdk-*.json

# smoke-test screenshots
scripts/smoke-artifacts/
