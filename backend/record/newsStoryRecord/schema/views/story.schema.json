{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story view",
  "description": "record/views/stories/{threadId}.json: facts projection, or an alias view for a merged story (0037 sections 1 and 3)",
  "oneOf": [
    {
      "$ref": "#/definitions/story"
    },
    {
      "$ref": "#/definitions/alias"
    }
  ],
  "definitions": {
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "iso": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:.]+Z$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "builtFrom": {
      "type": "object",
      "required": [
        "factsThrough",
        "readingsThrough"
      ],
      "additionalProperties": false,
      "properties": {
        "factsThrough": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "readingsThrough": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-W\\d{2}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "newest ISO week among the readings the build used; null when there are none"
        }
      }
    },
    "story": {
      "type": "object",
      "required": [
        "schemaVersion",
        "builtFrom",
        "threadId",
        "born",
        "aliasOf",
        "iso3",
        "actorIds",
        "sourceIds",
        "entries",
        "entriesOmitted",
        "forks",
        "merges",
        "corrections",
        "line",
        "chapters",
        "reading",
        "analysis"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "builtFrom": {
          "$ref": "#/definitions/builtFrom"
        },
        "threadId": {
          "type": "string"
        },
        "born": {
          "anyOf": [
            {
              "$ref": "#/definitions/day"
            },
            {
              "type": "null"
            }
          ]
        },
        "aliasOf": {
          "type": "null"
        },
        "iso3": {
          "$ref": "#/definitions/strings"
        },
        "actorIds": {
          "$ref": "#/definitions/strings"
        },
        "sourceIds": {
          "$ref": "#/definitions/strings"
        },
        "entries": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "anyOf": [
              {
                "$ref": "#/definitions/entry"
              },
              {
                "$ref": "#/definitions/articleEntry"
              }
            ]
          }
        },
        "entriesOmitted": {
          "type": "integer",
          "minimum": 0
        },
        "forks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/fork"
          }
        },
        "merges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "into",
              "at",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string"
              },
              "into": {
                "type": "string"
              },
              "at": {
                "$ref": "#/definitions/iso"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "corrects",
              "at",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "corrects": {
                "type": "string"
              },
              "at": {
                "$ref": "#/definitions/iso"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "line": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "text",
                "week",
                "cites"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "week": {
                  "type": "string",
                  "pattern": "^\\d{4}-W\\d{2}$"
                },
                "cites": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "minItems": 1
                }
              }
            }
          ]
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "from",
              "to",
              "summary",
              "cites"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "$ref": "#/definitions/day"
              },
              "to": {
                "$ref": "#/definitions/day"
              },
              "summary": {
                "type": "string",
                "maxLength": 300
              },
              "cites": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "minItems": 1
              }
            }
          }
        },
        "reading": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "state",
                "reason"
              ],
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "none"
                },
                "reason": {
                  "const": "no reading yet"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "state",
                "week"
              ],
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "read"
                },
                "week": {
                  "type": "string",
                  "pattern": "^\\d{4}-W\\d{2}$"
                }
              }
            }
          ]
        },
        "analysis": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "threadId",
                "generatedAt"
              ],
              "properties": {
                "threadId": {
                  "type": "string"
                },
                "generatedAt": {
                  "type": "string"
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "iso3": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "driftNote": {
                  "type": "object",
                  "required": [
                    "whyChanged",
                    "generatedAt"
                  ],
                  "description": "the story's latest drift note as stored (what changed since the previous reading); absent when it has none"
                }
              }
            }
          ],
          "description": "the latest story analysis note (decision 0042), model text, in the shape newsThreadAnalysis stores it"
        }
      }
    },
    "alias": {
      "type": "object",
      "required": [
        "schemaVersion",
        "builtFrom",
        "threadId",
        "aliasOf"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "builtFrom": {
          "$ref": "#/definitions/builtFrom"
        },
        "threadId": {
          "type": "string"
        },
        "aliasOf": {
          "type": "string"
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "eventId",
        "date",
        "at",
        "precision",
        "title",
        "summary",
        "category",
        "eventType",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "type": "string"
        },
        "date": {
          "$ref": "#/definitions/day"
        },
        "at": {
          "$ref": "#/definitions/iso"
        },
        "precision": {
          "enum": [
            "exact",
            "day"
          ]
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/source"
          }
        },
        "fromThreadId": {
          "type": "string",
          "description": "present on an entry that came from a story merged into this one"
        },
        "reassignedFrom": {
          "type": "string",
          "description": "present on an entry whose current assignment (0040 rule 3) moved it here from the archive thread named"
        },
        "corrected": {
          "const": true,
          "description": "present when a correction fact names this entry"
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "actor display names (entries from 2026-10-31)"
        },
        "notes": {
          "type": "object",
          "description": "model notes about this entry (decision 0042): the latest per part; model text, never a fact",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "object",
              "required": [
                "format",
                "content",
                "at",
                "model"
              ],
              "additionalProperties": false,
              "properties": {
                "format": {
                  "enum": [
                    "markdown",
                    "json",
                    "text"
                  ]
                },
                "content": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object"
                    }
                  ]
                },
                "at": {
                  "$ref": "#/definitions/iso"
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "from": {
                  "enum": [
                    "archive"
                  ],
                  "description": "an archive copy (cut at 1,500 characters, model not recorded)"
                }
              }
            },
            "prediction": {
              "type": "object",
              "required": [
                "format",
                "content",
                "at",
                "model"
              ],
              "additionalProperties": false,
              "properties": {
                "format": {
                  "enum": [
                    "markdown",
                    "json",
                    "text"
                  ]
                },
                "content": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object"
                    }
                  ]
                },
                "at": {
                  "$ref": "#/definitions/iso"
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "from": {
                  "enum": [
                    "archive"
                  ],
                  "description": "an archive copy (cut at 1,500 characters, model not recorded)"
                }
              }
            },
            "cause": {
              "type": "object",
              "required": [
                "format",
                "content",
                "at",
                "model"
              ],
              "additionalProperties": false,
              "properties": {
                "format": {
                  "enum": [
                    "markdown",
                    "json",
                    "text"
                  ]
                },
                "content": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object"
                    }
                  ]
                },
                "at": {
                  "$ref": "#/definitions/iso"
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "from": {
                  "enum": [
                    "archive"
                  ],
                  "description": "an archive copy (cut at 1,500 characters, model not recorded)"
                }
              }
            }
          }
        },
        "topicId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "the archive topic of the entry (tracing and the page's forecast and analysis lookups)"
        },
        "iso3": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "countries of the entry (ISO3), as recorded on the fact"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "sourceId",
        "outlet",
        "url",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "outlet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "outletCountry": {
          "type": [
            "string",
            "null"
          ],
          "description": "from the outlet table at build time"
        },
        "outletType": {
          "type": [
            "string",
            "null"
          ],
          "description": "from the outlet table at build time"
        },
        "snippet": {
          "type": "string"
        },
        "tier": {
          "enum": [
            "primary",
            "secondary"
          ]
        }
      }
    },
    "fork": {
      "type": "object",
      "required": [
        "forkId",
        "drawnAt",
        "branches"
      ],
      "additionalProperties": false,
      "properties": {
        "forkId": {
          "type": "string"
        },
        "drawnAt": {
          "$ref": "#/definitions/iso"
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/branch"
          }
        }
      }
    },
    "branch": {
      "type": "object",
      "required": [
        "branchId",
        "text",
        "p",
        "trigger",
        "resolutionSource",
        "due",
        "verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "branchId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "trigger": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolutionSource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "due": {
          "anyOf": [
            {
              "$ref": "#/definitions/day"
            },
            {
              "type": "null"
            }
          ]
        },
        "legacy": {
          "const": true
        },
        "verdict": {
          "anyOf": [
            {
              "$ref": "#/definitions/verdict"
            },
            {
              "type": "null"
            }
          ]
        },
        "question": {
          "type": "boolean",
          "description": "a scoreable question of the forecast loop (0038)"
        },
        "qid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "the question id, /track-record?q=<qid>; null on a legacy branch"
        },
        "scenarioP": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "the probability of the branch's scenario, as drawn"
        },
        "scoring": {
          "anyOf": [
            {
              "enum": [
                "sampled",
                "not_eligible",
                "warm_up",
                "awaiting_draw",
                "not_sampled"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "where the question stands in the weekly sample (0043); null on a legacy branch"
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no",
                "void",
                "awaiting",
                "past_deadline_unchecked"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "the outcome of a sampled question (0043); null when the question was not sampled or the branch is legacy"
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": [
        "at",
        "result",
        "decidedBy",
        "evidence",
        "voidReason"
      ],
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "#/definitions/iso"
        },
        "result": {
          "enum": [
            "yes",
            "no",
            "void"
          ]
        },
        "decidedBy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {},
        "voidReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "articleEntry": {
      "type": "object",
      "description": "an article fact placed on this story by an assignment (the assignment names the article's eventId)",
      "required": [
        "eventId",
        "date",
        "at",
        "precision",
        "title",
        "summary",
        "sources",
        "kind",
        "recovered",
        "recoveredFrom"
      ],
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "type": "string"
        },
        "date": {
          "$ref": "#/definitions/day"
        },
        "at": {
          "$ref": "#/definitions/iso"
        },
        "precision": {
          "enum": [
            "exact",
            "day"
          ]
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "outlet",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "outlet": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "url": {
                "type": "string"
              }
            }
          }
        },
        "kind": {
          "const": "article"
        },
        "recovered": {
          "type": "boolean"
        },
        "recoveredFrom": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fromThreadId": {
          "type": "string",
          "description": "present on an entry that came from a story merged into this one"
        },
        "corrected": {
          "const": true,
          "description": "present when a correction fact names this entry"
        }
      }
    }
  }
}
