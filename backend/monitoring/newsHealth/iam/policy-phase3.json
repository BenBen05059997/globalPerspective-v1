{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRecordWorldAndMerges",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::globalperspective-world-280362093938/record/*",
        "arn:aws:s3:::globalperspective-world-280362093938/world/latest.json",
        "arn:aws:s3:::globalperspective-world-280362093938/situations/merges/*",
        "arn:aws:s3:::globalperspective-world-280362093938/monitoring/ops.json"
      ]
    },
    {
      "Sid": "ListBucketSoAMissingKeyIsNotAnAccessDenied",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::globalperspective-world-280362093938"
    },
    {
      "Sid": "WriteTheTwoFiles",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::globalperspective-world-280362093938/record/views/health.json",
        "arn:aws:s3:::globalperspective-world-280362093938/monitoring/ops.json"
      ]
    },
    {
      "Sid": "LogsInsightsOverTheNewsGroups",
      "Effect": "Allow",
      "Action": "logs:StartQuery",
      "Resource": "arn:aws:logs:ap-northeast-1:280362093938:log-group:/aws/lambda/news*:*"
    },
    {
      "Sid": "LogsInsightsResultsAndGroupNames",
      "Effect": "Allow",
      "Action": [
        "logs:GetQueryResults",
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LambdaErrorMetrics",
      "Effect": "Allow",
      "Action": "cloudwatch:GetMetricData",
      "Resource": "*"
    },
    {
      "Sid": "CostExplorerOncePerDay",
      "Effect": "Allow",
      "Action": "ce:GetCostAndUsage",
      "Resource": "*"
    },
    {
      "Sid": "ResolverStatusReadOnlyInvoke",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:ap-northeast-1:280362093938:function:newsPredictionResolver"
    },
    {
      "Sid": "OwnTablesProjectedScanOnly",
      "Effect": "Allow",
      "Action": "dynamodb:Scan",
      "Resource": [
        "arn:aws:dynamodb:ap-northeast-1:280362093938:table/GlobalPerspectiveUserTable",
        "arn:aws:dynamodb:ap-northeast-1:280362093938:table/GlobalPerspectiveSavedItems",
        "arn:aws:dynamodb:ap-northeast-1:280362093938:table/GlobalPerspectiveShares",
        "arn:aws:dynamodb:ap-northeast-1:280362093938:table/GlobalPerspectiveClientErrors"
      ]
    },
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-northeast-1:280362093938:log-group:/aws/lambda/newsHealth:*"
    }
  ]
}
