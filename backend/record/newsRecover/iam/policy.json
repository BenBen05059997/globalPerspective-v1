{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ArticlesInboxReadAppend",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::globalperspective-world-280362093938/record/inbox/articles/*"
    },
    {
      "Sid": "ResultFileForTheCaller",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::globalperspective-world-280362093938/monitoring/heal/recover/*"
    },
    {
      "Sid": "ListBucketSoAMissingDayIsNotAnAccessDenied",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::globalperspective-world-280362093938"
    },
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-northeast-1:280362093938:log-group:/aws/lambda/newsRecover:*"
    }
  ]
}
