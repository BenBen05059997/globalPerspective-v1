{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://globalperspective.net/schema/record-note.json",
  "title": "Note (one line of record/notes/<subtype>/YYYY-MM-DD.jsonl), decision 0042",
  "type": "object",
  "required": [
    "schemaVersion",
    "noteId",
    "subtype",
    "subject",
    "part",
    "threadId",
    "iso3",
    "at",
    "date",
    "payload",
    "cites",
    "model",
    "promptVersion",
    "producer"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "noteId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "sha1('note|' + subtype + '|' + subject.id + '|' + part + '|' + at), shared record.js noteId"
    },
    "subtype": {
      "enum": [
        "entry",
        "story_analysis",
        "drift",
        "country",
        "link",
        "web",
        "brief"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "entry",
            "story",
            "country",
            "pair",
            "brief"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "an entry eventId, a threadId, an ISO3 code, pairKey(a, b), or daily:YYYY-MM-DD / weekly:YYYY-Www; never a title or topicId"
        }
      }
    },
    "part": {
      "type": "string",
      "description": "which text of the subject: summary | prediction | cause for an entry; '' when the subtype has one text"
    },
    "threadId": {
      "type": [
        "string",
        "null"
      ]
    },
    "iso3": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      }
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "when the model wrote it"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "UTC date of at; the file the note is in"
    },
    "payload": {
      "type": "object"
    },
    "cites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "description": "the model that wrote the note; null only on an archive copy (payload.from = archive), whose writer did not record it"
    },
    "promptVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "producer": {
      "type": "object",
      "required": [
        "lambda",
        "runId"
      ],
      "additionalProperties": false,
      "properties": {
        "lambda": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subtype": {
            "const": "entry"
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "entry"
              }
            }
          },
          "part": {
            "enum": [
              "summary",
              "prediction",
              "cause"
            ]
          },
          "cites": {
            "minItems": 1
          },
          "payload": {
            "required": [
              "format",
              "content",
              "topicId"
            ],
            "additionalProperties": false,
            "properties": {
              "format": {
                "enum": [
                  "markdown",
                  "json",
                  "text"
                ],
                "description": "text = an archive copy: the stored text, possibly cut at 1,500 characters; its original format is not restored"
              },
              "content": {
                "description": "exactly what the model produced: markdown text, or the parsed JSON object",
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object"
                  }
                ]
              },
              "topicId": {
                "type": "string",
                "description": "the archive topic the agent wrote it for; tracing only"
              },
              "from": {
                "enum": [
                  "archive"
                ],
                "description": "present on a copy taken from the NewsCache archive (backfill); views prefer an exact note"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "payload": {
                  "properties": {
                    "format": {
                      "const": "markdown"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "properties": {
                    "content": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "payload": {
                  "properties": {
                    "format": {
                      "const": "json"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "properties": {
                    "content": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "payload": {
                  "properties": {
                    "format": {
                      "const": "text"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "required": [
                    "from"
                  ],
                  "properties": {
                    "content": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subtype": {
            "const": "story_analysis"
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "story"
              }
            }
          },
          "part": {
            "const": ""
          },
          "payload": {
            "description": "the THREAD_ANALYSIS item as newsThreadAnalysis stores it, minus keys, ttl and what the envelope carries (threadId, iso3, generatedAt as at, model). Backfilled analyses may lack entryTopicIds (then no cites) and carry groundingSources/searchResultsCount.",
            "required": [
              "threadTitle",
              "entryShortTitles",
              "storyArc",
              "trajectory",
              "rootCauseChain",
              "watchQuestions",
              "inflectionTopicId",
              "riskScore",
              "dimensions",
              "lead",
              "sentiment",
              "keyActors",
              "entryCount",
              "latencyMs"
            ],
            "additionalProperties": false,
            "properties": {
              "threadTitle": {
                "type": "string",
                "minLength": 1
              },
              "entryShortTitles": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "storyArc": {
                "type": "string",
                "minLength": 1
              },
              "trajectory": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rootCauseChain": {
                "type": [
                  "string",
                  "object",
                  "null"
                ],
                "description": "a string, or the structured chain older analyses stored"
              },
              "watchQuestions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "inflectionTopicId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "riskScore": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "dimensions": {
                "type": "object"
              },
              "lead": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sentiment": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "keyActors": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "entryCount": {
                "type": "integer"
              },
              "entryTopicIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "latencyMs": {
                "type": "number"
              },
              "groundingSources": {
                "type": "array",
                "description": "stored by analyses from the search-grounded era (before the record); absent on current ones"
              },
              "searchResultsCount": {
                "type": "number",
                "description": "as groundingSources"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subtype": {
            "const": "drift"
          }
        }
      },
      "then": {
        "properties": {
          "part": {
            "const": ""
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "subject": {
                  "properties": {
                    "kind": {
                      "const": "country"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "iso3": {
                  "minItems": 1
                },
                "subject": {
                  "properties": {
                    "id": {
                      "pattern": "^[A-Z]{3}$"
                    }
                  }
                },
                "payload": {
                  "description": "the DRIFT# item as newsDriftCorrector stores it for a country, minus keys, ttl and generatedAt (the note's at). Older DRIFTLOG# items (backfill) lack currentRiskScore.",
                  "required": [
                    "countryName",
                    "asOf",
                    "since",
                    "changeScore",
                    "whyChanged",
                    "noSingleDriver"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "countryName": {
                      "type": "string",
                      "minLength": 1
                    },
                    "asOf": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "since": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "changeLevel": {
                      "type": "object"
                    },
                    "changeScore": {
                      "type": "object",
                      "required": [
                        "from",
                        "to",
                        "delta"
                      ]
                    },
                    "changeDimensions": {
                      "type": "object"
                    },
                    "priorHeadline": {
                      "type": "string"
                    },
                    "currentHeadline": {
                      "type": "string"
                    },
                    "currentDimensions": {
                      "type": "object"
                    },
                    "currentRiskScore": {
                      "type": "number"
                    },
                    "currentRiskLevel": {
                      "type": "string"
                    },
                    "currentLead": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "triggerEvent": {
                      "type": "object",
                      "required": [
                        "topicId",
                        "title"
                      ]
                    },
                    "whyChanged": {
                      "type": "string",
                      "minLength": 1
                    },
                    "noSingleDriver": {
                      "type": "boolean"
                    },
                    "directionFlag": {
                      "type": "object"
                    },
                    "from": {
                      "enum": [
                        "archive"
                      ],
                      "description": "present on a copy taken from the permanent DRIFTLOG# archive (backfill), which stored no model: the note's model is then null"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "subject": {
                  "properties": {
                    "kind": {
                      "const": "story"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "threadId": {
                  "type": "string",
                  "minLength": 1
                },
                "payload": {
                  "description": "the THREAD# DRIFT# item as newsDriftCorrector stores it for a story, minus keys, ttl and generatedAt (the note's at); threadId stays. The stored items carry no countries (iso3 may be empty).",
                  "required": [
                    "threadId",
                    "asOf",
                    "since",
                    "changeScore",
                    "whyChanged",
                    "noSingleDriver"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "threadId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "asOf": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "since": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "changeScore": {
                      "type": "object",
                      "required": [
                        "from",
                        "to",
                        "delta"
                      ]
                    },
                    "changeDimensions": {
                      "type": "object"
                    },
                    "priorTitle": {
                      "type": "string"
                    },
                    "currentTitle": {
                      "type": "string"
                    },
                    "triggerEvent": {
                      "type": "object",
                      "required": [
                        "topicId",
                        "title"
                      ]
                    },
                    "whyChanged": {
                      "type": "string",
                      "minLength": 1
                    },
                    "noSingleDriver": {
                      "type": "boolean"
                    },
                    "directionFlag": {
                      "type": "object"
                    },
                    "from": {
                      "enum": [
                        "archive"
                      ],
                      "description": "a copy taken from the stored THREAD# DRIFT# item by the backfill, which stored no model: the note's model is then null"
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "subject": {
                "properties": {
                  "kind": {
                    "enum": [
                      "country",
                      "story"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subtype": {
            "const": "country"
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "country"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subtype": {
            "const": "link"
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "pair"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subtype": {
            "const": "brief"
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "brief"
              },
              "id": {
                "pattern": "^(daily:\\d{4}-\\d{2}-\\d{2}|weekly:\\d{4}-W\\d{2})$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subtype": {
            "const": "country"
          }
        }
      },
      "then": {
        "properties": {
          "iso3": {
            "minItems": 1
          },
          "subject": {
            "properties": {
              "id": {
                "pattern": "^[A-Z]{3}$"
              }
            }
          },
          "part": {
            "const": ""
          },
          "payload": {
            "description": "the COUNTRY_INTELLIGENCE item newsCountryIntelligence stores, minus keys, ttl, generatedAt (the note's at) and model; or, with from 'history', the reduced HISTORY# row of an older day (backfill only, model null)",
            "required": [
              "countryName",
              "riskLevel",
              "riskScore",
              "trajectory"
            ],
            "additionalProperties": false,
            "properties": {
              "countryName": {
                "type": "string",
                "minLength": 1
              },
              "headline": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bluf": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "keyDevelopments": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "whyItMatters": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "situationSummary": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "backgroundTimeline": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "crossThreadInsight": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "trajectory": {
                "type": "string",
                "minLength": 1
              },
              "trajectoryDetail": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "riskSignals": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "riskLevel": {
                "type": "string",
                "minLength": 1
              },
              "riskScore": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "dimensions": {
                "type": "object"
              },
              "lead": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "keyActors": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "dominantCategory": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "categories": {
                "type": "object"
              },
              "totalArticles": {
                "type": "number"
              },
              "activeArcCount": {
                "type": "number"
              },
              "threadIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "the stories the briefing rests on (threadIds, not eventIds); absent on briefings stored before they were kept"
              },
              "dateRange": {
                "type": "object"
              },
              "dayCount": {
                "type": "number"
              },
              "latencyMs": {
                "type": "number"
              },
              "searchResultsCount": {
                "type": "number",
                "description": "legacy field of briefings stored by an older version"
              },
              "groundingSources": {
                "type": "array",
                "description": "legacy field of briefings stored by an older version"
              },
              "from": {
                "enum": [
                  "history"
                ],
                "description": "present on a reduced copy of a HISTORY# row (backfill); views prefer an exact note"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "payload": {
                  "required": [
                    "from"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "model": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "model": {
                  "type": "string"
                },
                "payload": {
                  "required": [
                    "bluf",
                    "keyDevelopments",
                    "whyItMatters"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subtype": {
            "const": "link"
          }
        }
      },
      "then": {
        "properties": {
          "iso3": {
            "minItems": 1,
            "maxItems": 1
          },
          "subject": {
            "properties": {
              "id": {
                "pattern": "^.+__.+$",
                "description": "pairKey(from, to) of the two thread ids"
              }
            }
          },
          "part": {
            "pattern": "^[A-Z]{3}$",
            "description": "ISO3 of the country web the link was read in"
          },
          "threadId": {
            "type": "null"
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "description": "null only on a copy rebuilt from the dated S3 web history (payload.source web-history): its rows did not record the model"
          },
          "payload": {
            "description": "one causal edge of a SYSTEMS# country web as the web index keeps it: from -> to (thread ids, the direction of influence), lagDays (to follows from by this many days), the model's mechanism, its confidence, the entries it cited",
            "required": [
              "from",
              "to",
              "country",
              "confidence",
              "lagDays",
              "mechanism",
              "cited"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "country": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "enum": [
                  "strong",
                  "medium",
                  "weak"
                ]
              },
              "lagDays": {
                "type": "integer"
              },
              "mechanism": {
                "type": "string",
                "minLength": 1
              },
              "cited": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "topicId"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "topicId": {
                      "type": "string"
                    },
                    "date": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    }
                  }
                }
              },
              "source": {
                "enum": [
                  "web-history"
                ],
                "description": "present on a link rebuilt from web/YYYY/MM/DD.json (backfill); views prefer an exact note"
              },
              "reverse": {
                "type": "object",
                "description": "the other direction of the pair in the same web (to -> from), when the web held both: the weaker one",
                "required": [
                  "confidence",
                  "lagDays",
                  "mechanism",
                  "cited"
                ],
                "additionalProperties": false,
                "properties": {
                  "confidence": {
                    "enum": [
                      "strong",
                      "medium",
                      "weak"
                    ]
                  },
                  "lagDays": {
                    "type": "integer"
                  },
                  "mechanism": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cited": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "topicId"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "topicId": {
                          "type": "string"
                        },
                        "date": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "payload": {
                  "required": [
                    "source"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "model": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "model": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subtype": {
            "const": "web"
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "country"
              },
              "id": {
                "pattern": "^[A-Z]{3}$",
                "description": "ISO3 of the country web"
              }
            }
          },
          "part": {
            "const": ""
          },
          "iso3": {
            "minItems": 1,
            "maxItems": 1
          },
          "threadId": {
            "type": "null"
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "description": "null only on a copy rebuilt from the dated S3 web history (payload.source web-history)"
          },
          "payload": {
            "description": "one SYSTEMS# country web: its nodes (threadIds, with or without an edge) and its deterministic shared-actor backbone",
            "required": [
              "country",
