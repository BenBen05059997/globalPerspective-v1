{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Analyses index (record/views/index/analyses.json)",
  "description": "Per story with a story_analysis note (`title` and the other shared story fields are story-stamp.schema.json; `threadTitle` stays the model paraphrase), the analysis fields the Stories page and the country page's arc list read (the thread_analysis action's answer, cut to those fields; no drift note, no entry short titles, no trajectory or root-cause text). Built by indexViews.js from the same notes as the story views' `analysis`.",
  "type": "object",
  "required": ["schemaVersion", "builtFrom", "analyses"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "builtFrom": {"type": "object"},
    "analyses": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["threadId", "title", "line", "lineWeek", "lineReason", "name", "iso3", "regions", "tier", "riskScore", "riskAt", "tierReason", "lastFactAt", "lastEntryAt", "category", "born", "themeId"],
        "additionalProperties": false,
        "properties": {
          "threadId": {"$ref": "story-stamp.schema.json#/properties/threadId"},
          "title": {"$ref": "story-stamp.schema.json#/properties/title"},
          "line": {"$ref": "story-stamp.schema.json#/properties/line"},
          "lineWeek": {"$ref": "story-stamp.schema.json#/properties/lineWeek"},
          "lineReason": {"$ref": "story-stamp.schema.json#/properties/lineReason"},
          "name": {"$ref": "story-stamp.schema.json#/properties/name"},
          "iso3": {"$ref": "story-stamp.schema.json#/properties/iso3"},
          "regions": {"$ref": "story-stamp.schema.json#/properties/regions"},
          "tier": {"$ref": "story-stamp.schema.json#/properties/tier"},
          "riskScore": {"$ref": "story-stamp.schema.json#/properties/riskScore"},
          "riskAt": {"$ref": "story-stamp.schema.json#/properties/riskAt"},
          "tierReason": {"$ref": "story-stamp.schema.json#/properties/tierReason"},
          "lastFactAt": {"$ref": "story-stamp.schema.json#/properties/lastFactAt"},
          "lastEntryAt": {"$ref": "story-stamp.schema.json#/properties/lastEntryAt"},
          "category": {"$ref": "story-stamp.schema.json#/properties/category"},
          "born": {"$ref": "story-stamp.schema.json#/properties/born"},
          "themeId": {"$ref": "story-stamp.schema.json#/properties/themeId"},
          "threadTitle": {"type": ["string", "null"]},
          "storyArc": {"type": ["string", "null"]},
          "watchQuestions": {"type": ["array", "null"], "items": {"type": "string"}},
          "dimensions": {"type": ["object", "null"]},
          "riskLevel": {"type": ["string", "null"]},
          "generatedAt": {"type": "string"}
        }
      }
    }
  }
}
