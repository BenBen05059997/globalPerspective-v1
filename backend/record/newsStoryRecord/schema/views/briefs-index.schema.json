{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Briefs index (record/views/index/briefs.json)",
  "description": "Which briefs exist: every daily brief (newest first, with its headline) and every published weekly brief (newest first, with its first signal's lede and the signal count). Lets the editions strip and the latest-brief lookups skip the per-day probes. Built by briefViews.js. A brief written after the last 23:45 UTC build is not in it yet: the readers ask the action for today.",
  "type": "object",
  "required": ["schemaVersion", "builtFrom", "daily", "weekly"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "builtFrom": {"type": "object"},
    "daily": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dateKey", "headline", "generatedAt"],
        "additionalProperties": false,
        "properties": {"dateKey": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "headline": {"type": "string"}, "generatedAt": {"type": "string"}}
      }
    },
    "weekly": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["weekOf", "asOf", "lede", "signals", "generatedAt"],
        "additionalProperties": false,
        "properties": {"weekOf": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "asOf": {"type": "string"}, "lede": {"type": ["string", "null"]}, "signals": {"type": "integer"}, "generatedAt": {"type": "string"}}
      }
    }
  }
}
