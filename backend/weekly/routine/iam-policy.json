{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-northeast-1:280362093938:table/NewsCache",
        "arn:aws:dynamodb:ap-northeast-1:280362093938:table/SummarizeAndPredict",
        "arn:aws:dynamodb:ap-northeast-1:280362093938:table/GlobalPerspectivePredictionLog"
      ]
    },
    {
      "Sid": "ReadWebAndWeekly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::globalperspective-world-280362093938/web/*",
        "arn:aws:s3:::globalperspective-world-280362093938/weekly/*"
      ]
    },
    {
      "Sid": "WriteWeeklyOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::globalperspective-world-280362093938/weekly/*"
      ]
    },
    {
      "Sid": "ListScoped",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::globalperspective-world-280362093938"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "web/*",
            "weekly/*"
          ]
        }
      }
    }
  ]
}
