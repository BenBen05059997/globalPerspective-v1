#!/usr/bin/env bash
# Pre-commit: fast checks only (2026-10-19 rules reset). Docs are required only for architecture
# changes (Stop hook reminder); git log is the change log (CHANGES.md deleted 2026-10-19).
# Bypass: git commit --no-verify.
set -e
cd "$(git rev-parse --show-toplevel)"
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && exit 0
STAGED=$(git diff --cached --name-only)
[ -z "$STAGED" ] && exit 0

# Operator-owned runtime config never goes in by accident.
if printf '%s\n' "$STAGED" | grep -qx 'docs/config.js'; then
  echo "==> docs/config.js is operator-owned; unstage it (or --no-verify if the operator asked)."; exit 1
fi

# Frontend style ratchets (colour literals; more checks live in quality/) when frontend source is staged.
if printf '%s\n' "$STAGED" | grep -qE '^global-perspectives-starter/frontend/src/.*\.(css|jsx|js)$'; then
  for c in quality/check_*.mjs; do [ -f "$c" ] && node "$c" >/dev/null || { node "$c"; exit 1; }; done
fi
exit 0
