{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://globalperspective.net/schema/record-note.json",
  "title": "Note (one line of record/notes/<subtype>/YYYY-MM-DD.jsonl), decision 0042",
  "type": "object",
  "required": [
    "schemaVersion",
    "noteId",
    "subtype",
    "subject",
    "part",
    "threadId",
    "iso3",
    "at",
    "date",
    "payload",
    "cites",
    "model",
    "promptVersion",
    "producer"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "noteId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "sha1('note|' + subtype + '|' + subject.id + '|' + part + '|' + at), shared record.js noteId"
    },
    "subtype": {
      "enum": [
        "entry",
        "story_analysis",
        "drift",
        "country",
        "link",
        "brief"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "entry",
            "story",
            "country",
            "pair",
            "brief"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "an entry eventId, a threadId, an ISO3 code, pairKey(a, b), or daily:YYYY-MM-DD / weekly:YYYY-Www; never a title or topicId"
        }
      }
    },
    "part": {
      "type": "string",
      "description": "which text of the subject: summary | prediction | cause for an entry; '' when the subtype has one text"
    },
    "threadId": {
      "type": [
        "string",
        "null"
      ]
    },
    "iso3": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      }
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "when the model wrote it"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "UTC date of at; the file the note is in"
    },
    "payload": {
      "type": "object"
    },
    "cites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model": {
      "type": "string"
    },
    "promptVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "producer": {
      "type": "object",
      "required": [
        "lambda",
        "runId"
      ],
      "additionalProperties": false,
      "properties": {
        "lambda": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subtype": {
            "const": "entry"
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "entry"
              }
            }
          },
          "part": {
            "enum": [
              "summary",
              "prediction",
              "cause"
            ]
          },
          "cites": {
            "minItems": 1
          },
          "payload": {
            "required": [
              "format",
              "content",
              "topicId"
            ],
            "additionalProperties": false,
            "properties": {
              "format": {
                "enum": [
                  "markdown",
                  "json"
                ]
              },
              "content": {
                "description": "exactly what the model produced: markdown text, or the parsed JSON object",
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object"
                  }
                ]
              },
              "topicId": {
                "type": "string",
                "description": "the archive topic the agent wrote it for; tracing only"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "payload": {
                  "properties": {
                    "format": {
                      "const": "markdown"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "properties": {
                    "content": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "payload": {
                  "properties": {
                    "format": {
                      "const": "json"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "properties": {
                    "content": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subtype": {
            "const": "story_analysis"
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "story"
              }
            }
          },
          "part": {
            "const": ""
          },
          "payload": {
            "description": "the THREAD_ANALYSIS item as newsThreadAnalysis stores it, minus keys, ttl and what the envelope carries (threadId, iso3, generatedAt as at, model)",
            "required": [
              "threadTitle",
              "entryShortTitles",
              "storyArc",
              "trajectory",
              "rootCauseChain",
              "watchQuestions",
              "inflectionTopicId",
              "riskScore",
              "dimensions",
              "lead",
              "sentiment",
              "keyActors",
              "entryCount",
              "entryTopicIds",
              "latencyMs"
            ],
            "additionalProperties": false,
            "properties": {
              "threadTitle": {
                "type": "string",
                "minLength": 1
              },
              "entryShortTitles": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "storyArc": {
                "type": "string",
                "minLength": 1
              },
              "trajectory": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rootCauseChain": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "watchQuestions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "inflectionTopicId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "riskScore": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "dimensions": {
                "type": "object"
              },
              "lead": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sentiment": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "keyActors": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "entryCount": {
                "type": "integer"
              },
              "entryTopicIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "latencyMs": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subtype": {
            "const": "drift"
          }
        }
      },
      "then": {
        "properties": {
          "iso3": {
            "minItems": 1
          },
          "subject": {
            "properties": {
              "id": {
                "pattern": "^[A-Z]{3}$"
              }
            }
          },
          "part": {
            "const": ""
          },
          "payload": {
            "description": "the DRIFT# item as newsDriftCorrector stores it for a country, minus keys, ttl and generatedAt (the note's at)",
            "required": [
              "countryName",
              "asOf",
              "since",
              "changeScore",
              "currentRiskScore",
              "whyChanged",
              "noSingleDriver"
            ],
            "additionalProperties": false,
            "properties": {
              "countryName": {
                "type": "string",
                "minLength": 1
              },
              "asOf": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "since": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "changeLevel": {
                "type": "object"
              },
              "changeScore": {
                "type": "object",
                "required": [
                  "from",
                  "to",
                  "delta"
                ]
              },
              "changeDimensions": {
                "type": "object"
              },
              "priorHeadline": {
                "type": "string"
              },
              "currentHeadline": {
                "type": "string"
              },
              "currentDimensions": {
                "type": "object"
              },
              "currentRiskScore": {
                "type": "number"
              },
              "currentRiskLevel": {
                "type": "string"
              },
              "currentLead": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "triggerEvent": {
                "type": "object",
                "required": [
                  "topicId",
                  "title"
                ]
              },
              "whyChanged": {
                "type": "string",
                "minLength": 1
              },
              "noSingleDriver": {
                "type": "boolean"
              },
              "directionFlag": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subtype": {
            "enum": [
              "drift",
              "country"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "country"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subtype": {
            "const": "link"
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "pair"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subtype": {
            "const": "brief"
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "brief"
              },
              "id": {
                "pattern": "^(daily:\\d{4}-\\d{2}-\\d{2}|weekly:\\d{4}-W\\d{2})$"
              }
            }
          }
        }
      }
    }
  ]
}
