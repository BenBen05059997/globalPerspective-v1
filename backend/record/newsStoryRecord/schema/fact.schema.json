{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://globalperspective.net/schema/record-fact.json",
  "title": "Fact (one line of record/facts/YYYY-MM-DD.jsonl), decision 0036 section 2",
  "type": "object",
  "required": ["schemaVersion", "eventId", "kind", "at", "date", "precision", "threadId", "iso3", "actorIds", "sourceIds", "payload", "producer", "sourceKey", "sourceRow"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "kind": { "enum": ["entry", "story_born", "forecast_drawn", "verdict", "correction", "story_merged", "story_split", "article", "assignment", "question_commit", "question_draw", "run"] },
    "at": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-\\d{2}-\\d{2}T[0-9:.]+Z$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "precision": { "enum": ["exact", "day"] },
    "threadId": { "type": ["string", "null"] },
    "iso3": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{3}$" }, "uniqueItems": true },
    "actorIds": { "type": "array", "items": { "type": "string", "pattern": "^name:.+" }, "uniqueItems": true },
    "sourceIds": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "uniqueItems": true },
    "payload": { "type": "object" },
    "producer": {
      "type": "object",
      "required": ["lambda", "runId"],
      "properties": { "lambda": { "type": "string", "pattern": "^newsStoryRecord@" }, "runId": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2}-\\d+|legacy-void-\\d{4}-\\d{2}-\\d{2}|assignments-backfill-\\d{4}-\\d{2}-\\d{2})$" } },
      "additionalProperties": false
    },
    "sourceKey": { "type": "string", "minLength": 1 },
    "sourceRow": {
      "type": "object",
      "required": ["store", "key"],
      "properties": { "store": { "type": "string" }, "key": { "type": ["object", "string"] }, "index": { "type": "integer", "minimum": 0 } }
    },
    "idBasis": { "enum": ["url", "title"] },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "outlet", "url", "title"],
        "properties": {
          "sourceId": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
          "outlet": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] },
          "title": { "type": ["string", "null"] },
          "snippet": { "type": "string", "description": "the feed's text for the article (raw capture, from 2026-10-31)" },
          "tier": { "enum": ["primary", "secondary"], "description": "primary = cited by the selector, secondary = added by code matching (from 2026-10-31)" }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "entry" } } },
      "then": {
        "required": ["idBasis", "sources"],
        "properties": {
          "payload": {
            "required": ["title", "summary", "category", "eventType", "continuesTopic", "topicId"],
            "properties": { "title": { "type": "string" }, "summary": { "type": ["string", "null"] }, "category": { "type": ["string", "null"] }, "eventType": { "type": ["string", "null"] }, "continuesTopic": { "type": ["string", "null"] }, "topicId": { "type": "string" }, "actors": { "type": "array", "items": { "type": "string" }, "description": "actor display names as captured (from 2026-10-31); actorIds holds the normalized ids" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "story_born" } } },
      "then": {
        "properties": {
          "threadId": { "type": "string" },
          "payload": {
            "required": ["born", "bornAtApprox", "firstTitle", "windowLimited", "missingBefore"],
            "properties": { "born": { "type": "string" }, "bornAtApprox": { "type": "boolean" }, "firstTitle": { "type": "string" }, "windowLimited": { "type": "boolean" }, "missingBefore": { "type": "array", "items": { "type": "string" } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "forecast_drawn" } } },
      "then": {
        "properties": {
          "threadId": { "type": "string" },
          "payload": {
            "required": ["forkId", "branches"],
            "properties": {
              "forkId": { "type": "string" },
              "branches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["branchId", "text", "p", "trigger", "resolutionSource", "due"],
                  "properties": { "branchId": { "type": "string" }, "text": { "type": "string" }, "p": { "type": ["number", "null"] }, "trigger": { "type": "string" }, "resolutionSource": { "type": "string" }, "due": { "type": ["string", "null"] } }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "verdict" } } },
      "then": {
        "properties": {
          "threadId": { "type": "string" },
          "payload": {
            "required": ["qid", "result", "decidedBy", "evidence"],
            "properties": { "qid": { "type": ["string", "null"] }, "result": { "enum": ["yes", "no", "void"] }, "decidedBy": { "type": ["string", "null"] }, "voidReason": { "type": ["string", "null"] } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "correction" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["corrects", "what", "reason"],
            "properties": { "corrects": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "what": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "story_merged" } } },
      "then": {
        "properties": {
          "threadId": { "type": "string" },
          "payload": {
            "required": ["from", "into", "reason", "evidence"],
            "properties": { "from": { "type": "string" }, "into": { "type": "string" }, "reason": { "type": "string", "minLength": 1 }, "evidence": { "type": "array" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "story_split" } } },
      "then": {
        "properties": {
          "threadId": { "type": "string" },
          "payload": {
            "required": ["from", "into", "reason"],
            "properties": { "from": { "type": "string" }, "into": { "type": "string" }, "reason": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "article" } } },
      "then": {
        "properties": {
          "threadId": { "type": "null" },
          "iso3": { "maxItems": 0 },
          "actorIds": { "maxItems": 0 },
          "payload": {
            "required": ["url", "canonicalUrl", "title", "outlet", "feed", "snippet", "lang", "recoveredAt", "recoveredFrom"],
            "properties": {
              "url": { "type": "string", "minLength": 1 }, "canonicalUrl": { "type": "string", "pattern": "^https?://" }, "title": { "type": "string", "minLength": 1 },
              "outlet": { "type": ["string", "null"] }, "feed": { "type": ["string", "null"] }, "snippet": { "type": ["string", "null"] }, "lang": { "type": ["string", "null"] },
              "recoveredAt": { "type": ["string", "null"] }, "recoveredFrom": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "assignment" } } },
      "then": {
        "properties": {
          "threadId": { "type": "string" },
          "payload": {
            "required": ["entryId", "threadId", "by", "supersedes", "reason"],
            "properties": {
              "entryId": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "the eventId of the entry" },
              "threadId": { "type": "string", "description": "the story the entry is assigned to; equals the envelope threadId" },
              "by": { "enum": ["ingest", "review", "operator"] },
              "supersedes": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$", "description": "the assignment eventId this replaces; informational, the views take the latest by at" },
              "reason": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "question_commit" } } },
      "then": {
        "properties": {
          "threadId": { "type": "null" },
          "iso3": { "maxItems": 0 },
          "actorIds": { "maxItems": 0 },
          "payload": {
            "required": ["weekId", "weekStart", "weekEnd", "rule", "commitHash"],
            "properties": {
              "weekId": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
              "weekStart": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "weekEnd": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "rule": { "type": "string", "minLength": 1 },
              "commitHash": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha-256 of the week's seed, published before the week starts" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "question_draw" } } },
      "then": {
        "properties": {
          "threadId": { "type": "null" },
          "iso3": { "maxItems": 0 },
          "actorIds": { "maxItems": 0 },
          "payload": {
            "required": ["weekId", "rule", "K", "eligible", "clusters", "seedHex", "picked"],
            "properties": {
              "weekId": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
              "rule": { "type": "string", "minLength": 1 },
              "K": { "type": ["integer", "null"], "minimum": 0 },
              "eligible": { "type": ["integer", "null"], "minimum": 0 },
              "clusters": { "type": ["integer", "null"], "minimum": 0 },
              "seedHex": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$", "description": "the revealed seed; sha-256 of it is the week's commitHash" },
              "picked": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["qid", "hash", "clusterKey"],
                  "properties": { "qid": { "type": "string", "minLength": 1 }, "hash": { "type": ["string", "null"] }, "clusterKey": { "type": ["string", "null"] } },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "run" } } },
      "then": {
        "properties": {
          "threadId": { "type": "null" },
          "payload": {
            "required": ["runId", "status", "counts"],
            "properties": { "runId": { "type": "string" }, "status": { "enum": ["ok", "partial", "failed"] }, "counts": { "type": "object" } }
          }
        }
      }
    }
  ]
}
