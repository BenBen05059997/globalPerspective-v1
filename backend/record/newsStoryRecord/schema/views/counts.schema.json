{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Daily counts view",
  "description": "record/views/counts/{date}.json (0037 section 1)",
  "type": "object",
  "required": [
    "schemaVersion",
    "builtFrom",
    "date",
    "articles",
    "byStory",
    "total"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "builtFrom": {
      "$ref": "#/definitions/builtFrom"
    },
    "date": {
      "$ref": "#/definitions/day"
    },
    "articles": {
      "type": "integer",
      "minimum": 0,
      "description": "article facts dated that day (the raw articles fetched; stories are chosen from them)"
    },
    "byStory": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/tri"
      }
    },
    "total": {
      "$ref": "#/definitions/tri"
    }
  },
  "definitions": {
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "iso": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:.]+Z$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "builtFrom": {
      "type": "object",
      "required": [
        "factsThrough",
        "readingsThrough"
      ],
      "additionalProperties": false,
      "properties": {
        "factsThrough": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "readingsThrough": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-W\\d{2}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "newest ISO week among the readings the build used; null when there are none"
        }
      }
    },
    "tri": {
      "type": "object",
      "required": [
        "newEntries",
        "branchesDue",
        "verdicts"
      ],
      "additionalProperties": false,
      "properties": {
        "newEntries": {
          "type": "integer",
          "minimum": 0
        },
        "branchesDue": {
          "type": "integer",
          "minimum": 0
        },
        "verdicts": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
