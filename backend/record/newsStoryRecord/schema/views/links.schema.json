{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Links view",
  "description": "record/views/links/{threadId}.json: shared facts between active stories, not judged links (0037 section 1)",
  "type": "object",
  "required": [
    "schemaVersion",
    "builtFrom",
    "threadId",
    "links",
    "confirmedLinks",
    "confirmedLinksReason"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "builtFrom": {
      "$ref": "#/definitions/builtFrom"
    },
    "threadId": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/definitions/link"
      }
    },
    "confirmedLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "otherThreadId",
          "mechanism",
          "direction",
          "week",
          "cites"
        ],
        "additionalProperties": false,
        "properties": {
          "otherThreadId": {
            "type": "string"
          },
          "mechanism": {
            "type": "string",
            "maxLength": 200
          },
          "direction": {
            "enum": [
              "drives",
              "driven_by",
              "shared_cause"
            ]
          },
          "week": {
            "type": "string",
            "pattern": "^\\d{4}-W\\d{2}$"
          },
          "cites": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "minItems": 1
          }
        }
      }
    },
    "confirmedLinksReason": {
      "anyOf": [
        {
          "const": "no reading yet"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "iso": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:.]+Z$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "builtFrom": {
      "type": "object",
      "required": [
        "factsThrough",
        "readingsThrough"
      ],
      "additionalProperties": false,
      "properties": {
        "factsThrough": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "readingsThrough": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-W\\d{2}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "newest ISO week among the readings the build used; null when there are none"
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "otherThreadId",
        "sharedActorIds",
        "sharedIso3",
        "sharedSourceIds",
        "grounds",
        "daysApart"
      ],
      "additionalProperties": false,
      "properties": {
        "otherThreadId": {
          "type": "string"
        },
        "sharedActorIds": {
          "$ref": "#/definitions/strings"
        },
        "sharedIso3": {
          "$ref": "#/definitions/strings"
        },
        "sharedSourceIds": {
          "$ref": "#/definitions/strings"
        },
        "grounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "description": "count of non-empty sharedActorIds and sharedIso3 (sources never count)"
        },
        "daysApart": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14
        }
      }
    }
  }
}
