#!/usr/bin/env bash
# Pre-push: run the frontend gate when frontend files are in the push. Bypass: git push --no-verify.
set -e
cd "$(git rev-parse --show-toplevel)"
RANGE="$(git rev-parse --abbrev-ref HEAD)@{u}..HEAD"
git rev-parse -q --verify "$(git rev-parse --abbrev-ref HEAD)@{u}" >/dev/null 2>&1 || RANGE='HEAD~10..HEAD'
CHANGED=$(git diff --name-only $RANGE 2>/dev/null || true)
if printf '%s\n' "$CHANGED" | grep -q '^global-perspectives-starter/frontend/'; then
  echo "==> frontend changed — npm run verify"
  (cd global-perspectives-starter/frontend && npm run verify --silent)
fi
exit 0
