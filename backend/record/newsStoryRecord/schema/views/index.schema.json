{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story index",
  "description": "record/views/index/active.json and index/all.json (0037 section 1); same shape, active excludes aliases and stories idle for 60 days",
  "type": "object",
  "required": [
    "schemaVersion",
    "builtFrom",
    "stories"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "builtFrom": {
      "$ref": "#/definitions/builtFrom"
    },
    "stories": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/row"
      }
    }
  },
  "definitions": {
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "iso": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:.]+Z$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "builtFrom": {
      "type": "object",
      "required": [
        "factsThrough",
        "readingsThrough"
      ],
      "additionalProperties": false,
      "properties": {
        "factsThrough": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "readingsThrough": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-W\\d{2}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "newest ISO week among the readings the build used; null when there are none"
        },
        "provisionalThrough": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "the newest day of the provisional facts (today's archive entries and today's forecasts before the nightly run has frozen them, 0050, 0052); absent when the build had none"
        }
      }
    },
    "row": {
      "type": "object",
      "required": [
        "threadId",
        "title",
        "line",
        "lineWeek",
        "lineReason",
        "name",
        "iso3",
        "regions",
        "tier",
        "riskScore",
        "riskAt",
        "tierReason",
        "lastFactAt",
        "lastEntryAt",
        "category",
        "born",
        "themeId",
        "actorIds",
        "sourceCount",
        "entryCount",
        "stepCount",
        "stepDays",
        "forkCount",
        "branchCount",
        "liveBranchCount",
        "latestVerdictAt",
        "aliasOf",
        "aliases"
      ],
      "additionalProperties": false,
      "properties": {
        "threadId": {"$ref": "story-stamp.schema.json#/properties/threadId"},
        "title": {"$ref": "story-stamp.schema.json#/properties/title"},
        "line": {"$ref": "story-stamp.schema.json#/properties/line"},
        "lineWeek": {"$ref": "story-stamp.schema.json#/properties/lineWeek"},
        "lineReason": {"$ref": "story-stamp.schema.json#/properties/lineReason"},
        "name": {"$ref": "story-stamp.schema.json#/properties/name"},
        "iso3": {"$ref": "story-stamp.schema.json#/properties/iso3"},
        "regions": {"$ref": "story-stamp.schema.json#/properties/regions"},
        "tier": {"$ref": "story-stamp.schema.json#/properties/tier"},
        "riskScore": {"$ref": "story-stamp.schema.json#/properties/riskScore"},
        "riskAt": {"$ref": "story-stamp.schema.json#/properties/riskAt"},
        "tierReason": {"$ref": "story-stamp.schema.json#/properties/tierReason"},
        "lastFactAt": {"$ref": "story-stamp.schema.json#/properties/lastFactAt"},
        "lastEntryAt": {"$ref": "story-stamp.schema.json#/properties/lastEntryAt"},
        "category": {"$ref": "story-stamp.schema.json#/properties/category"},
        "born": {"$ref": "story-stamp.schema.json#/properties/born"},
        "themeId": {"$ref": "story-stamp.schema.json#/properties/themeId"},
        "actorIds": {
          "$ref": "#/definitions/strings"
        },
        "sourceCount": {
          "type": "integer",
          "minimum": 0
        },
        "entryCount": {
          "type": "integer",
          "minimum": 0,
          "description": "rows of the story view before the cap, placed articles included"
        },
        "stepCount": {
          "type": "integer",
          "minimum": 0,
          "description": "the story's steps (non-article rows, re-dated repeats left out), as the story view's stepCount; 0 on an alias row"
        },
        "stepDays": {
          "type": "integer",
          "minimum": 0,
          "description": "the distinct record dates of those steps; 0 on an alias row"
        },
        "forkCount": {
          "type": "integer",
          "minimum": 0
        },
        "branchCount": {
          "type": "integer",
          "minimum": 0
        },
        "liveBranchCount": {
          "type": "integer",
          "minimum": 0
        },
        "latestVerdictAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/iso"
            },
            {
              "type": "null"
            }
          ]
        },
        "aliasOf": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "aliases": {
          "$ref": "#/definitions/strings"
        }
      }
    }
  }
}
